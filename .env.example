# Optional runtime overrides for a portable TJXY release.
# Keep credentials and database URLs only in your local .env file.
# TJXY_BIND=127.0.0.1:8096
# Overrides the auto-discovered local data/jellyfin-web directory.
# TJXY_JELLYFIN_WEB_DIST_DIR=/usr/share/jellyfin/web
# TJXY_DATABASE_URL=sqlite://tjxy.db?mode=rwc
# TJXY_CONFIG_FILE=
# TJXY_SETUP_DATA_DIR=data
# TJXY_LOG_FILE=data/server.log
